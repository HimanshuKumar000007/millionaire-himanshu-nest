# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_API_KEY: Required for NVIDIA Nemotron AI Reasoning & Intelligence Layer.
# Keep strictly server-side (never expose to client via NEXT_PUBLIC_*).
NVIDIA_API_KEY="nvapi-..."

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
