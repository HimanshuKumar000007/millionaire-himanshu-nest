# ==============================================================================
# SciPrep — Environment Variables Configuration
# ==============================================================================

# ── RESEND EMAIL (Password Reset & Transactional) ─────────────────────────────
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key_here"

# ── SUPABASE CONFIGURATION (Database & Auth) ──────────────────────────────────
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ── RAILWAY BACKEND CONFIGURATION (Optional API Gateway) ──────────────────────
# Set to your deployed Railway backend URL (or leave blank if using Next.js App Router API)
NEXT_PUBLIC_API_URL="https://your-backend-production.up.railway.app"

# ── AI & INTELLIGENCE ENGINES ─────────────────────────────────────────────────
# Gemini AI: Required for interactive AI tutor and smart explanations
GEMINI_API_KEY="your-gemini-api-key"

# NVIDIA Nemotron: Required for deep reasoning and question diagnostics
NVIDIA_API_KEY="nvapi-..."

# ── APP URL ───────────────────────────────────────────────────────────────────
# Official Custom Domain URL
APP_URL="https://sciprep.in"
